<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>release</id>
    <formats>
        <format>tar.gz</format>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${project.artifactId}-${project.version}</baseDirectory>

    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>${project.artifactId}.jar</destName>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <source>src/main/resources/application.yml</source>
            <outputDirectory>config</outputDirectory>
            <destName>application.yml</destName>
            <fileMode>0644</fileMode>
        </file>
    </files>

    <fileSets>
        <fileSet>
            <directory>../agent</directory>
            <outputDirectory>ops/agent</outputDirectory>
            <includes><include>agent.py</include><include>stack_ops.py</include><include>installer.py</include><include>agent-release.json</include><include>config.example.json</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>../deploy/container-platform</directory>
            <outputDirectory>ops/container-platform</outputDirectory>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>../docs/container-ops</directory>
            <outputDirectory>ops/docs</outputDirectory>
            <includes><include>02-deployment.md</include><include>08-customer-delivery.md</include><include>10-simple-image-workflow.md</include><include>11-runtime-console.md</include><include>12-one-click-installation.md</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>../scripts</directory>
            <outputDirectory>ops/tools</outputDirectory>
            <includes><include>install-agent-release.py</include><include>build-install-bundle.py</include><include>open-platform-firewall.ps1</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>../docs/container-ops/simple-workflow-evidence</directory>
            <outputDirectory>ops/docs/simple-workflow-evidence</outputDirectory>
            <includes><include>*.json</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>../docs/container-ops/runtime-console-evidence</directory>
            <outputDirectory>ops/docs/runtime-console-evidence</outputDirectory>
            <includes><include>*.json</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>../docs/container-ops/installer-evidence</directory>
            <outputDirectory>ops/docs/installer-evidence</outputDirectory>
            <includes><include>*.json</include><include>*.png</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/main/assembly/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>templates</directory>
            <outputDirectory>templates</outputDirectory>
            <includes>
                <include>*.j2</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/main/assembly/logs</directory>
            <outputDirectory>logs</outputDirectory>
            <includes>
                <include>.gitkeep</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/main/assembly/data</directory>
            <outputDirectory>data</outputDirectory>
            <includes>
                <include>.gitkeep</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>
</assembly>
