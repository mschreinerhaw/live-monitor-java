<div style="font-family:Arial,'Microsoft YaHei',sans-serif;color:#1f2937;line-height:1.65;font-size:14px;">
  <div style="font-size:20px;font-weight:700;color:#b91c1c;margin-bottom:14px;">数据库业务断言告警</div>

  <div style="margin-bottom:14px;">
    <div>服务名称：{{ serviceName }}</div>
    <div>实例名称：{{ instanceName }}</div>
    <div>数据库类型：{{ databaseProduct }}</div>
    <div>告警级别：{{ level }}</div>
    <div>告警时间：{{ alertTime }}</div>
    <div>响应时间：{{ responseTime }} ms</div>
  </div>

  <div style="font-weight:700;margin-top:12px;">业务结论</div>
  <div style="margin:6px 0 12px 0;">{{ databaseSummary }}</div>

  <div style="font-weight:700;margin-top:12px;">检测结果</div>
  <pre style="font-family:Consolas,'Microsoft YaHei',monospace;white-space:pre-wrap;margin:6px 0 12px 0;color:#111827;background:transparent;">{{ databaseResult }}</pre>

  <div style="font-weight:700;margin-top:12px;">规则与原因</div>
  <div>规则：{{ databaseRule }}</div>
  <div>命中信息：{{ databaseHit }}</div>
  <div>失败原因：{{ databaseReason }}</div>

  <div style="font-weight:700;margin-top:12px;">影响判断</div>
  <div>{{ businessImpact }}</div>

  <div style="font-weight:700;margin-top:12px;">处理建议</div>
  <div>{{ actionSuggestion }}</div>
</div>
